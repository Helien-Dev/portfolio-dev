---
import type { SkillData } from '../../types/skill.types';

interface Props {
  skill: SkillData;
}

const { skill } = Astro.props;
---

<li class="skill-item">{skill.name}</li>

<style>
  .skill-item {
    font-size: 0.95rem;
    color: #a3adc2;
    transition: color 0.2s ease;
  }

  .skill-item:hover {
    color: #2563eb;
  }

  @media screen and (max-width: 640px) {
    .skill-item {
      font-size: 0.85rem;
    }
  }
</style>

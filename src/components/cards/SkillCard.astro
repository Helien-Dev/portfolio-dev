---
import type { SkillData } from '../../types/skill.types';

interface Props {
  skill: SkillData;
}

const { skill } = Astro.props;
---

<li class="skill-item">
  <svg class="skill-icon" width="30" height="30" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
    <path d={skill.icon.path} fill-rule={skill.icon.fillRule} />
  </svg>
  <span class="skill-name">{skill.name}</span>
</li>

<style>
  .skill-item {
    position: relative;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 3.75rem;
    height: 3.75rem;
    color: #a3adc2;
    transition: color 0.2s ease;
  }

  .skill-icon {
    flex: none;
    width: 30px;
    height: 30px;
  }

  .skill-item:hover {
    color: #2563eb;
  }

  /* Name stays hidden until the icon is hovered, shown as a small tooltip above it. */
  .skill-name {
    position: absolute;
    bottom: 100%;
    left: 50%;
    transform: translate(-50%, -6px);
    padding: 0.25rem 0.55rem;
    border-radius: 0.375rem;
    background-color: rgba(28, 28, 31, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.08);
    font-size: 0.75rem;
    font-weight: 500;
    color: #e5e7eb;
    white-space: nowrap;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s ease;
  }

  .skill-item:hover .skill-name {
    opacity: 1;
  }

  @media screen and (max-width: 640px) {
    .skill-item {
      width: 3.25rem;
      height: 3.25rem;
    }
  }
</style>

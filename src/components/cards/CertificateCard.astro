---
import { getCardImage } from '../../lib/images';

import DownloadButton from '../buttons/DownloadButton.astro';

import type { CertificateData } from '../../types/certificate.types';

interface Props {
    certificate: CertificateData;
}

const { certificate } = Astro.props;
const certificateImage = await getCardImage(certificate.pdfImage, 700);
---

<details class="certificate-item">
    <summary class="certificate-summary">
        <span class="certificate-heading">
            {certificate.issuer}
            <span class="text-blue-600"> - </span>
            {certificate.title}
        </span>
        <svg
            class="chevron"
            xmlns="http://www.w3.org/2000/svg"
            width="20"
            height="20"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
        >
            <path d="m6 9 6 6 6-6" />
        </svg>
    </summary>

    <div class="certificate-content">
        <img
            class="certificate-image"
            src={certificateImage.src}
            {...certificateImage.attributes}
            alt={certificate.imageAlt}
        />
        <div class="certificate-info">
            <p class="certificate-description">{certificate.description}</p>
            <DownloadButton
                href={certificate.pdfSrc}
                label={certificate.pdfName}
                fileName={certificate.pdfName}
            />
        </div>
    </div>
</details>

<style>

.certificate-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.25rem 0;
    cursor: pointer;
    list-style: none;
}

.certificate-summary::-webkit-details-marker {
    display: none;
}

.certificate-summary:hover .certificate-heading,
.certificate-summary:hover .chevron {
    color: #fb923c;
}

.certificate-heading {
    font-size: 1.1rem;
    font-weight: bold;
    transition: color 0.2s ease;
}

.chevron {
    flex-shrink: 0;
    color: #93a3b8;
    transition: transform 0.2s ease, color 0.2s ease;
}

.certificate-item[open] .chevron {
    transform: rotate(180deg);
}

/* The dropdown acts as a toggle button: stays highlighted while open, not just on hover. */
.certificate-item[open] .certificate-heading,
.certificate-item[open] .chevron {
    color: #fb923c;
}

.certificate-content {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1.5rem;
    padding: 0 0 1.5rem;
}

.certificate-image {
    flex: 1 1 320px;
    max-width: 500px;
    width: 100%;
    height: auto;
    border-radius: 1rem;
}

.certificate-info {
    flex: 1 1 240px;
}

.certificate-description {
    margin-bottom: 1rem;
}

/* Estilos responsivos */
@media screen and (max-width: 1024px) {
    .certificate-heading {
        font-size: 1rem;
    }
}

@media screen and (max-width: 640px) {
    .certificate-summary {
        padding: 1rem 0;
    }
    .certificate-content {
        flex-direction: column;
        padding: 0 0 1rem;
    }
}
</style>

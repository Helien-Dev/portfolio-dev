---
import type { SkillGroupData } from '../../types/skill.types';
import SkillCard from './SkillCard.astro';

interface Props {
  group: SkillGroupData;
  /** Whether this group's dropdown starts expanded. */
  open?: boolean;
}

const { group, open = false } = Astro.props;
---

<details class="skill-group" open={open}>
  <summary class="skill-group-summary">
    <span>{group.title}</span>
    <svg
      class="chevron"
      xmlns="http://www.w3.org/2000/svg"
      width="20"
      height="20"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
    >
      <path d="m6 9 6 6 6-6" />
    </svg>
  </summary>
  <ul class="skill-group-content">
    {group.skills.map((skill) => <SkillCard skill={skill} />)}
  </ul>
</details>

<style>
  .skill-group-summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding: 1.1rem 0;
    font-weight: bold;
    font-size: 1.05rem;
    color: #e5e7eb;
    cursor: pointer;
    list-style: none;
  }

  .skill-group-summary::-webkit-details-marker {
    display: none;
  }

  .skill-group-summary:hover {
    color: #fb923c;
  }

  .chevron {
    flex-shrink: 0;
    transition: transform 0.2s ease;
  }

  .skill-group[open] .chevron {
    transform: rotate(180deg);
  }

  /* The dropdown acts as a toggle button: stays highlighted while open, not just on hover. */
  .skill-group[open] .skill-group-summary {
    color: #fb923c;
  }

  .skill-group-content {
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
    padding: 0 0 1.25rem;
    list-style: none;
  }

  @media screen and (max-width: 640px) {
    .skill-group-summary {
      padding: 0.9rem 0;
      font-size: 0.95rem;
    }

    .skill-group-content {
      gap: 0.35rem;
      padding: 0 0 1rem;
    }
  }
</style>

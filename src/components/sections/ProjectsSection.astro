---
import GithubButton from '../buttons/GithubButton.astro';
import DailyButton from '../buttons/DailyButton.astro';

import { getCardImage } from '../../lib/images';

import { projects } from '../../data/projects.data';

const PAGE_SIZE = 5;

const featuredProjects = projects.filter((project) => project.featured);
const listedProjects = projects.filter((project) => !project.featured);
const totalPages = Math.ceil(listedProjects.length / PAGE_SIZE);

const slides = await Promise.all(
  featuredProjects.map(async (project) => {
    const image = await getCardImage(project.image, 500, 300);
    return {
      title: project.title,
      description: project.description,
      imageSrc: image.src,
      imageAlt: project.imageAlt,
      githubLink: project.githubLink,
      dailyLink: project.dailyLink,
    };
  }),
);

const first = slides[0];
// Serialized once for the client script — escape "</" so a description can never break out of the script tag.
const slidesJson = JSON.stringify(slides).replace(/<\//g, '<\\/');
---

<h2 class="projects-title" id="projects">
  Proyectos <span class="text-blue-600">/></span>
</h2>

<article class="projects-container">
  <div class="projects-block">
    {
      first && (
        <div class="showcase" data-slides={slidesJson}>
          <img id="showcase-image" class="showcase-image" src={first.imageSrc} alt={first.imageAlt} />
          <div class="showcase-info">
            <h3 id="showcase-title" class="showcase-title">{first.title}</h3>
            <p id="showcase-description" class="showcase-description">{first.description}</p>
            <div class="showcase-buttons">
              <GithubButton href={first.githubLink} />
              <DailyButton href={first.dailyLink} />
            </div>
          </div>

          <div class="showcase-bullets">
            {featuredProjects.map((_, index) => (
              <button
                type="button"
                class="showcase-bullet"
                data-index={index}
                aria-label={`Mostrar proyecto ${index + 1}`}
              />
            ))}
          </div>
        </div>
      )
    }

    {
      listedProjects.length > 0 && (
        <div class="projects-list-block">
          <ul class="projects-list">
            {listedProjects.map((project, index) => (
              <li class="projects-list-item" data-page={Math.floor(index / PAGE_SIZE)}>
                <a class="projects-list-link" href={project.githubLink} target="_blank">
                  <span class="projects-list-number">{index + 1}.</span>
                  {project.title}
                  <span class="projects-list-description">— {project.description}</span>
                </a>
              </li>
            ))}
          </ul>

          {totalPages > 1 && (
            <div class="list-pagination">
              {Array.from({ length: totalPages }, (_, page) => (
                <button
                  type="button"
                  class="list-page-dot"
                  data-page={page}
                  aria-label={`Página ${page + 1}`}
                />
              ))}
            </div>
          )}
        </div>
      )
    }
  </div>
</article>

<script src="../../scripts/projectShowcase.ts"></script>
<script src="../../scripts/projectsListPagination.ts"></script>

<style>
  .projects-title {
    font-size: 2rem;
    font-weight: bold;
    text-align: left;
    margin-bottom: 1.5rem;
    padding: 1rem;
  }

  .projects-container {
    margin: auto;
    padding: 1rem;
    max-width: 1000px;
  }

  .projects-block {
    background-color: rgba(28, 28, 31, 0.55);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-radius: 1.5rem;
  }

  .showcase {
    position: relative;
    display: flex;
    gap: 1.5rem;
    align-items: center;
    padding: 1.5rem;
    padding-bottom: 2.5rem;
  }

  .showcase-image {
    width: 45%;
    max-width: 320px;
    border-radius: 1.5rem;
    object-fit: cover;
  }

  .showcase-info {
    flex: 1;
  }

  .showcase-title {
    font-size: 1.5rem;
    font-weight: bold;
  }

  .showcase-description {
    margin-top: 0.5rem;
    color: #a3adc2;
  }

  .showcase-buttons {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin-top: 1rem;
  }

  .showcase-bullets {
    position: absolute;
    right: 1.5rem;
    bottom: 1rem;
    display: flex;
    gap: 0.5rem;
  }

  .showcase-bullet,
  .list-page-dot {
    display: block;
    width: 8px;
    height: 8px;
    padding: 0;
    border: none;
    border-radius: 50%;
    background-color: #3f3f46;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .showcase-bullet:hover,
  .list-page-dot:hover {
    background-color: #6b7280;
  }

  .showcase-bullet.is-active,
  .showcase-bullet.is-active:hover,
  .list-page-dot.is-active,
  .list-page-dot.is-active:hover {
    background-color: #fb923c;
  }

  .projects-list-block {
    padding: 0.5rem 2rem 1rem;
  }

  .showcase + .projects-list-block {
    border-top: 1px solid rgba(255, 255, 255, 0.08);
  }

  .projects-list {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .projects-list-item {
    padding: 0.35rem 0;
  }

  .projects-list-number {
    color: rgba(255, 255, 255, 0.55);
    margin-right: 0.35rem;
  }

  .projects-list-link {
    color: rgba(255, 255, 255, 0.55);
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .projects-list-description {
    margin-left: 0.5rem;
    font-size: 0.85rem;
    color: rgba(255, 255, 255, 0.35);
    transition: color 0.2s ease;
  }

  .projects-list-link:hover {
    color: #2563eb;
  }

  .projects-list-link:hover .projects-list-description {
    color: #2563eb;
  }

  .list-pagination {
    display: flex;
    justify-content: flex-end;
    gap: 0.5rem;
    margin-top: 0.75rem;
  }

  @media screen and (max-width: 1024px) {
    .projects-title {
      font-size: 1.8rem;
    }
  }

  @media screen and (max-width: 768px) {
    .projects-title {
      font-size: 1.6rem;
    }
  }

  @media screen and (max-width: 640px) {
    .projects-title {
      font-size: 1.4rem;
    }
    .projects-container {
      padding: 0.5rem;
    }
    .showcase {
      flex-direction: column;
      align-items: flex-start;
    }
    .showcase-image {
      width: 100%;
      max-width: none;
    }
  }
</style>

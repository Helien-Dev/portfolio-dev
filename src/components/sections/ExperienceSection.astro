---
import ExperienceCard from '../cards/ExperienceCard.astro';
import { experience } from '../../data/experience.data';
---

<article class="experience-section">
  <h2 class="experience-title">
    Experiencia <span class="text-blue-600">/></span>
  </h2>

  <ol class="timeline">
    {experience.map((item) => <ExperienceCard experience={item} />)}
  </ol>
</article>

<style>
  .experience-section {
    max-width: 1000px;
    margin: auto;
    padding: 1rem;
    text-align: left;
  }

  .experience-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
  }

  .timeline {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  @media screen and (max-width: 768px) {
    .experience-title {
      font-size: 1.75rem;
    }
  }

  @media screen and (max-width: 640px) {
    .experience-title {
      font-size: 1.5rem;
    }
  }
</style>

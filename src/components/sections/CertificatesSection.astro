---
import CertificateCard from '../cards/CertificateCard.astro';

import { certificates } from '../../data/certificates.data';
---
<article class="certificates-section">
    <h2 class="certificates-title">
        Certificados <span class="text-blue-600">/></span>
    </h2>

    <div class="certificates-grid">
        {certificates.map((certificate) => <CertificateCard certificate={certificate} />)}
    </div>
</article>

<style>
/* Estilos principales */
.certificates-section {
    max-width: 1200px;
    margin: auto;
    padding: 1.5rem;
    text-align: left;
}

.certificates-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 2rem;
}

.certificates-grid {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1.5rem;
}

/* Estilos responsivos */
@media screen and (max-width: 1024px) {
    .certificates-title {
        font-size: 1.8rem;
    }
    .certificates-grid {
        grid-template-columns: 1fr;
        gap: 1rem;
        padding: 1rem;
    }
}

@media screen and (max-width: 768px) {
    .certificates-title {
        font-size: 1.6rem;
    }
    .certificates-grid {
        gap: 0.75rem;
    }
}

@media screen and (max-width: 640px) {
    .certificates-title {
        font-size: 1.4rem;
    }
    .certificates-section {
        padding: 1rem;
    }
    .certificates-grid {
        gap: 0.5rem;
    }
}
</style>

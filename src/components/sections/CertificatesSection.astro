---
import CertificateCard from '../cards/CertificateCard.astro';

import { certificates } from '../../data/certificates.data';
---
<article class="certificates-section">
    <h2 class="certificates-title">
        Certificados <span class="text-blue-600">/></span>
    </h2>

    <div class="certificates-list">
        {certificates.map((certificate) => <CertificateCard certificate={certificate} />)}
    </div>
</article>

<style>
/* Estilos principales */
.certificates-section {
    max-width: 1000px;
    margin: auto;
    padding: 1.5rem;
    text-align: left;
}

.certificates-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
}

.certificates-list {
    background-color: #1c1c1f;
    border-radius: 1.5rem;
    padding: 0.5rem 1.5rem;
    display: flex;
    flex-direction: column;
}

/* Estilos responsivos */
@media screen and (max-width: 1024px) {
    .certificates-title {
        font-size: 1.8rem;
    }
}

@media screen and (max-width: 768px) {
    .certificates-title {
        font-size: 1.6rem;
    }
}

@media screen and (max-width: 640px) {
    .certificates-title {
        font-size: 1.4rem;
    }
    .certificates-section {
        padding: 1rem;
    }
    .certificates-list {
        padding: 0.5rem 1rem;
    }
}
</style>

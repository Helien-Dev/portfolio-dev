---
import Subheading from '../ui/Subheading.astro';
import SkillCard from '../cards/SkillCard.astro';
import { skillGroups } from '../../data/skills.data';
---

<article class="skills-section">
  <h2 class="skills-title">Habilidades <span class="text-blue-600">/></span></h2>

  {
    skillGroups.map((group) => (
      <div class="skill-group">
        <Subheading>{group.title}</Subheading>
        <div class="skills-grid">
          {group.skills.map((skill) => (
            <SkillCard skill={skill} />
          ))}
        </div>
      </div>
    ))
  }
</article>

<style>
  .skills-section {
    max-width: 1200px;
    margin: auto;
    padding: 1rem;
    text-align: center;
  }

  .skills-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .skill-group {
    margin-bottom: 2.5rem;
  }

  .skill-group:last-child {
    margin-bottom: 0;
  }

  .skills-grid {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    justify-content: flex-start;
  }

  @media screen and (max-width: 1024px) {
    .skills-title {
      font-size: 1.8rem;
    }
  }

  @media screen and (max-width: 768px) {
    .skills-title {
      font-size: 1.6rem;
    }
  }

  @media screen and (max-width: 640px) {
    .skills-title {
      font-size: 1.4rem;
    }
  }
</style>

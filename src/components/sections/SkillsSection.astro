---
import SkillGroupCard from '../cards/SkillGroupCard.astro';
import { skillGroups } from '../../data/skills.data';
---

<article class="skills-section">
  <h2 class="skills-title">Habilidades <span class="text-blue-600">/></span></h2>

  <div class="skill-groups">
    {skillGroups.map((group, index) => <SkillGroupCard group={group} open={index === 0} />)}
  </div>
</article>

<style>
  .skills-section {
    max-width: 1200px;
    margin: auto;
    padding: 1rem;
  }

  .skills-title {
    font-size: 2rem;
    font-weight: bold;
    margin-bottom: 1.5rem;
    text-align: left;
  }

  .skill-groups {
    background-color: #1c1c1f;
    border-radius: 1.5rem;
    padding: 0.5rem 1.5rem;
    display: flex;
    flex-direction: column;
  }

  @media screen and (max-width: 1024px) {
    .skills-title {
      font-size: 1.8rem;
    }
  }

  @media screen and (max-width: 768px) {
    .skills-title {
      font-size: 1.6rem;
    }
  }

  @media screen and (max-width: 640px) {
    .skills-title {
      font-size: 1.4rem;
    }

    .skill-groups {
      padding: 0.5rem 1rem;
    }
  }
</style>

---

---

<!-- Main navigation container -->
<nav
  class="relative flex w-full flex-nowrap items-center justify-between  py-2  lg:flex-wrap lg:justify-start lg:py-4"
>
  <div class="flex w-full flex-wrap items-center justify-between px-3">
    <div class="ms-2">
      <a class="text-xl text-white font-bold" target="_blank" href="https://github.com/Helien-Dev"
        ><p class="inline text-blue-600">Dev</p>/AlvaroAvila</a
      >
    </div>
    <!-- Button for mobile view -->
    <button
      class="block border-0 bg-transparent px-2 text-black/50 hover:no-underline hover:shadow-none focus:no-underline focus:shadow-none focus:outline-none focus:ring-0 lg:hidden"
      type="button"
      data-collapse-toggle="navbarSupportedContent3"
      aria-controls="navbarSupportedContent3"
      aria-expanded="false"
      aria-label="Toggle navigation"
    >
      <!-- icon -->
      <span
        class="[&>svg]:w-7 [&>svg]:stroke-black/50 dark:[&>svg]:stroke-neutral-200"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          fill="currentColor"
        >
          <path
            fill-rule="evenodd"
            d="M3 6.75A.75.75 0 013.75 6h16.5a.75.75 0 010 1.5H3.75A.75.75 0 013 6.75zM3 12a.75.75 0 01.75-.75h16.5a.75.75 0 010 1.5H3.75A.75.75 0 013 12zm0 5.25a.75.75 0 01.75-.75h16.5a.75.75 0 010 1.5H3.75a.75.75 0 01-.75-.75z"
            clip-rule="evenodd"></path>
        </svg>
      </span>
    </button>

    <!-- Collapsible navbar container -->
    <div
      class="!visible mt-2 hidden flex-grow basis-[100%] items-center lg:mt-0 lg:!flex lg:basis-auto"
      id="navbarSupportedContent3"
    >
      <!-- Left links -->
      <ul
        class="list-style-none me-auto flex flex-col ps-0 lg:mt-1 lg:flex-row"
      >
        <!-- Home link -->
        <li class="my-4 ps-2 lg:my-0 lg:pe-1 lg:ps-2">
          <a
            class="p-0 text-black/60 transition duration-200 hover:text-black/80 hover:ease-in-out focus:text-black/80 active:text-black/80 motion-reduce:transition-none dark:text-white/60 dark:hover:text-white/80 dark:focus:text-white/80 dark:active:text-white/80 lg:px-2"
            aria-current="page"
            href="https://dailydev.lat/"
            >Daily</a
          >
        </li>
        <!-- Features link -->
        <li class="mb-4 ps-2 lg:mb-0 lg:pe-1 lg:ps-0">
          <a
            class="p-0 text-black/60 transition duration-200 hover:text-black/80 hover:ease-in-out focus:text-black/80 active:text-black/80 motion-reduce:transition-none dark:text-white/60 dark:hover:text-white/80 dark:focus:text-white/80 dark:active:text-white/80 lg:px-2"
            href="#projects"
            >Proyectos</a
          >
        </li>
        <!-- Pricing link -->
        <li class="mb-4 ps-2 lg:mb-0 lg:pe-1 lg:ps-0">
          <a
            class="p-0 text-black/60 transition duration-200 hover:text-black/80 hover:ease-in-out focus:text-black/80 active:text-black/80 motion-reduce:transition-none dark:text-white/60 dark:hover:text-white/80 dark:focus:text-white/80 dark:active:text-white/80 lg:px-2"
            href="#contactme"
            >Contactame</a
          >
        </li>
      </ul>
      <span class="text-white">Github</span>
    </div>
  </div>
</nav>

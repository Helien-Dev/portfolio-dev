---
// Layout
import Layout from '../layouts/Layout.astro';

// Layout components
import Navbar from '../components/layout/Navbar.astro';
import Footer from '../components/layout/Footer.astro';

// UI components
import Subheading from '../components/ui/Subheading.astro';
import DownloadButton from '../components/buttons/DownloadButton.astro';

// Sections
import AboutSection from '../components/sections/AboutSection.astro';
import ExperienceSection from '../components/sections/ExperienceSection.astro';
import ProjectsSection from '../components/sections/ProjectsSection.astro';
import SkillsSection from '../components/sections/SkillsSection.astro';
import CertificatesSection from '../components/sections/CertificatesSection.astro';
import GithubActivitySection from '../components/sections/GithubActivitySection.astro';
import ContactSection from '../components/sections/ContactSection.astro';
// Note: OutstandingSection exists under components/sections but isn't linked
// here yet — enable it once there are projects worth featuring separately.

const cvDownload = {
	href: '/pdf/cv-alvaro-avila.pdf',
	label: 'Descargar CV',
	fileName: 'Alvaro Avila - Hoja de vida.pdf',
};
---

<Layout title="Alvaro Avila dev | Desarrollador">
	<header class="hero-viewport">
		<Navbar />
		<!-- Presentation Section -->
		<section class="hero-section py-[50px]">
			<article class="presentation-section" id="presentation-section">
				<div class="image-animation">
					<img src="/images/hero-avatar.jpg" alt="alvaroavila">
				</div>
				<div class="presentation-description">
					<div>
						<h1 class="text-center font-semibold whitespace-nowrap">Alvaro Avila<p class="inline text-blue-600">Dev</p></h1>
						<Subheading>
							Desarrollador end<span class="text-blue-600 font-extrabold">-to-</span>end
						</Subheading>

						<!-- Description Section -->
						<article class="py-1">
							<ul class="text-left">
								<li><p>- RPA: automatizo procesos de negocio y aumento la productividad.</p></li>
								<li><p>- DevOps: gestiono la infra del proyecto con Docker y Proxmox.</p></li>
								<li><p>- Fullstack: desarrollo aplicaciones web completas, de interfaz a API.</p></li>
							</ul>
						</article>

						<!-- Social media + Cv download -->
						<div class="actions-row">
							<div class="social-media">
								<a class="hover:text-blue-600" href="https://github.com/Helien-Dev" aria-label="GitHub"><svg xmlns="http://www.w3.org/2000/svg" width="50px" height="50px" viewBox="0 0 24 24"><mask id="lineMdGithubLoop0" width="24" height="24" x="0" y="0"><g fill="#fff"><ellipse cx="9.5" cy="9" rx="1.5" ry="1"/><ellipse cx="14.5" cy="9" rx="1.5" ry="1"/></g></mask><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path stroke-dasharray="32" stroke-dashoffset="32" d="M12 4c1.67 0 2.61 0.4 3 0.5c0.53 -0.43 1.94 -1.5 3.5 -1.5c0.34 1 0.29 2.22 0 3c0.75 1 1 2 1 3.5c0 2.19 -0.48 3.58 -1.5 4.5c-1.02 0.92 -2.11 1.37 -3.5 1.5c0.65 0.54 0.5 1.87 0.5 2.5c0 0.73 0 3 0 3M12 4c-1.67 0 -2.61 0.4 -3 0.5c-0.53 -0.43 -1.94 -1.5 -3.5 -1.5c-0.34 1 -0.29 2.22 0 3c-0.75 1 -1 2 -1 3.5c0 2.19 0.48 3.58 1.5 4.5c1.02 0.92 2.11 1.37 3.5 1.5c-0.65 0.54 -0.5 1.87 -0.5 2.5c0 0.73 0 3 0 3"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.7s" values="32;0"/></path><path stroke-dasharray="10" stroke-dashoffset="10" d="M9 19c-1.406 0-2.844-.563-3.688-1.188C4.47 17.188 4.22 16.157 3 15.5"><animate attributeName="d" dur="3s" repeatCount="indefinite" values="M9 19c-1.406 0-2.844-.563-3.688-1.188C4.47 17.188 4.22 16.157 3 15.5;M9 19c-1.406 0-3-.5-4-.5-.532 0-1 0-2-.5;M9 19c-1.406 0-2.844-.563-3.688-1.188C4.47 17.188 4.22 16.157 3 15.5"/><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.8s" dur="0.2s" values="10;0"/></path></g><rect width="8" height="4" x="8" y="11" fill="currentColor" mask="url(#lineMdGithubLoop0)"><animate attributeName="y" dur="10s" keyTimes="0;0.45;0.46;0.54;0.55;1" repeatCount="indefinite" values="11;11;7;7;11;11"/></rect></svg></a>

								<span class="hover:text-blue-600"><svg xmlns="http://www.w3.org/2000/svg" width="50px" height="50px" viewBox="0 0 24 24"><circle cx="4" cy="4" r="2" fill="currentColor" fill-opacity="0"><animate fill="freeze" attributeName="fill-opacity" dur="0.15s" values="0;1"/></circle><g fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="4"><path stroke-dasharray="12" stroke-dashoffset="12" d="M4 10v10"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.15s" dur="0.2s" values="12;0"/></path><path stroke-dasharray="12" stroke-dashoffset="12" d="M10 10v10"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.45s" dur="0.2s" values="12;0"/></path><path stroke-dasharray="24" stroke-dashoffset="24" d="M10 15c0 -2.76 2.24 -5 5 -5c2.76 0 5 2.24 5 5v5"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.65s" dur="0.2s" values="24;0"/></path></g></svg></span>

								<a class="hover:text-blue-600" href="#contactme" aria-label="Ir a la sección de contacto"><svg xmlns="http://www.w3.org/2000/svg" width="50px" height="50px" viewBox="0 0 24 24"><mask id="lineMdEmailPlusTwotone0"><g fill="none" stroke="#fff" stroke-linecap="round" stroke-linejoin="round" stroke-width="2"><path stroke-dasharray="64" stroke-dashoffset="64" d="M4 5h16c0.55 0 1 0.45 1 1v12c0 0.55 -0.45 1 -1 1h-16c-0.55 0 -1 -0.45 -1 -1v-12c0 -0.55 0.45 -1 1 -1Z"><animate fill="freeze" attributeName="stroke-dashoffset" dur="0.6s" values="64;0"/></path><path stroke-dasharray="24" stroke-dashoffset="24" d="M3 6.5l9 5.5l9 -5.5"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.6s" dur="0.2s" values="24;0"/></path><path fill="#fff" fill-opacity="0" stroke="none" d="M12 11l-8 -5h16l-8 5Z"><animate fill="freeze" attributeName="fill-opacity" begin="1.2s" dur="0.15s" values="0;0.3"/></path><path fill="#000" fill-opacity="0" stroke="none" d="M19 13c3.31 0 6 2.69 6 6c0 3.31 -2.69 6 -6 6c-3.31 0 -6 -2.69 -6 -6c0 -3.31 2.69 -6 6 -6Z"><set fill="freeze" attributeName="fill-opacity" begin="0.8s" to="1"/></path><path stroke-dasharray="8" stroke-dashoffset="8" d="M16 19h6"><animate fill="freeze" attributeName="stroke-dashoffset" begin="0.8s" dur="0.2s" values="8;0"/></path><path stroke-dasharray="8" stroke-dashoffset="8" d="M19 16v6"><animate fill="freeze" attributeName="stroke-dashoffset" begin="1s" dur="0.2s" values="8;0"/></path></g></mask><rect width="24" height="24" fill="currentColor" mask="url(#lineMdEmailPlusTwotone0)"/></svg></a>
							</div>

							<!-- Cv Download Button -->
							<DownloadButton {...cvDownload} />
						</div>
					</div>
				</div>
			</article>
			</section>

			<!-- Scroll indicator -->
			<a href="#about" class="scroll-indicator" aria-label="Desplázate hacia abajo">
				<svg
					xmlns="http://www.w3.org/2000/svg"
					width="24"
					height="24"
					viewBox="0 0 24 24"
					fill="none"
					stroke="currentColor"
					stroke-width="2"
					stroke-linecap="round"
					stroke-linejoin="round"
				>
					<path d="m6 9 6 6 6-6" />
				</svg>
			</a>
	</header>

	<main>
			<!-- About me Section  -->
			<section id="about" class="w-full m-auto max-w-[1000px] py-5 about-anchor">
				<AboutSection />
			</section>
			
			<!-- Experience Section  -->
			<section class="w-full m-auto max-w-[1000px] py-5">
				<ExperienceSection />
			</section>

			<!-- Projects Section -->
			<section class="w-full m-auto max-w-[800px]">
				<ProjectsSection />
			</section>

			<!-- Skills Section -->
			<section class="w-full m-auto max-w-[1000px]">
				<SkillsSection />
			</section>

			<!-- Certificates Section -->
			<section class="w-full m-auto max-w-[1000px]">
				<CertificatesSection />
			</section>

			<!-- Github Activity Section -->
			<section class="w-full m-auto max-w-[1000px]">
				<GithubActivitySection />
			</section>

			<!-- Contact section -->
			<section class="w-full m-auto max-w-[1000px]">
				<ContactSection />
			</section>

	</main>
	<!-- Footer Section -->
	<Footer />
	<script src="../scripts/heroScroll.ts"></script>
</Layout>

<style>
	main {
		color: white;
	}

	.hero-viewport {
		position: relative;
		display: flex;
		flex-direction: column;
		min-height: 100vh;
		min-height: 100svh;
		color: white;
	}

	.scroll-indicator {
		position: absolute;
		right: 1.5rem;
		bottom: 1.5rem;
		color: #2563eb;
		transition: opacity 0.2s ease;
		animation: bounce-arrow 1.8s ease-in-out infinite;
	}

	.scroll-indicator:hover {
		opacity: 0.7;
	}

	@media (prefers-reduced-motion: reduce) {
		.scroll-indicator {
			animation: none;
		}
	}

	@keyframes bounce-arrow {
		0%,
		100% {
			transform: translateY(0);
		}
		50% {
			transform: translateY(8px);
		}
	}

	.hero-section {
		flex: 1;
		display: flex;
		align-items: center;
	}

	h1 {
		font-size: 4rem;
		font-weight: 700;
		line-height: 1;
		text-align: center;
	}

	.presentation-section {
		margin: auto;
		width: 100%;
		max-width: 800px;
		text-align: center;
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem
	}

	.presentation-description {
		width: 100%;
		display: flex;
		align-items: center;
	}

	.actions-row {
		display: flex;
		align-items: center;
		justify-content: flex-start;
		gap: 50px;
	}

	.social-media {
		display: flex;
		align-items: center;
		gap: 20px;
	}

	.image-animation img {
		width: 400px;
		height: 400px;
		max-width: none;
		border-radius: 1.5rem;
		object-fit: fill;
	}

	.image-animation img{
		animation-name: image-animation;
		animation-duration: 7s;
		animation-direction: alternate-reverse;
		animation-iteration-count: infinite;
		animation-timing-function: ease-in-out;
	}

	@media screen and (max-width: 1024px) {
	h1 {
		font-size: 2rem;
	}
	.image-animation img {
		width: 300px;
		height: 300px;
	}
}

@media screen and (max-width: 768px) {
  h1 {
    font-size: 1.75rem;
  }
  .presentation-section {
    flex-direction: column;
  }
  .image-animation img {
    width: 250px;
    height: 250px;
  }
}

	@media screen and (max-width: 640px) {
	h1 {
		font-size: 1.5rem;
	}
	.presentation-section {
		margin: auto;
		width: 100%;
		max-width: 100%;
		text-align: center;
		display: flex;
		flex-direction: column;
		justify-content: center;
	}
	.presentation-description {
		padding: 1rem;
	}
	.social-media svg {
		width: 40px;
		height: 40px;
	}
	.scroll-indicator {
		display: none;
	}
	}

	@keyframes image-animation {
	0% {
		box-shadow: 0 5px 15px 0px rgba(0,0,0,0.6);
		transform: translatey(0px);
	}
	50% {
		box-shadow: 0 25px 15px 0px rgba(0,0,0,0.2);
		transform: translatey(-25px);
	}
	100% {
		box-shadow: 0 5px 15px 0px rgba(0,0,0,0.6);
		transform: translatey(0px);
	}
}

</style>
